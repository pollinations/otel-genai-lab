{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pollinations/otel-genai-lab/fixtures/scenarios/v0.2/schema.json",
  "title": "Cache, deduplication, and detached GenAI gateway scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "summary",
    "mode",
    "request",
    "observations",
    "expected"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^s[4-6]-[a-z0-9-]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["cache_hit", "concurrent_deduplication", "detached_execution"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedModel"],
      "properties": {
        "requestedModel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "outcome", "startOffsetMs", "durationMs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^observation-[1-9][0-9]*$"
          },
          "role": {
            "enum": ["request", "result"]
          },
          "outcome": {
            "enum": ["cache_hit", "generated_result", "scheduled"]
          },
          "startOffsetMs": {
            "type": "integer",
            "minimum": 0
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "startOffsetMs",
        "durationMs",
        "provider",
        "resolvedModel",
        "usage"
      ],
      "properties": {
        "execution": {
          "enum": ["shared", "detached"]
        },
        "startOffsetMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "correlationId": {
          "type": "string",
          "pattern": "^corr-[a-z0-9-]{1,32}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "resolvedModel": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalOperations",
        "generations",
        "providerAttempts",
        "resultObservations",
        "usageOwners",
        "continuity",
        "metricAccountingGuarantee"
      ],
      "properties": {
        "logicalOperations": {
          "type": "integer",
          "minimum": 1
        },
        "generations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "providerAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "resultObservations": {
          "type": "integer",
          "minimum": 1
        },
        "usageOwners": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "continuity": {
          "enum": ["none", "trace_links", "durable_correlation"]
        },
        "metricAccountingGuarantee": {
          "const": "not_asserted"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "cache_hit"
          }
        }
      },
      "then": {
        "properties": {
          "generation": false
        }
      },
      "else": {
        "required": ["generation"],
        "properties": {
          "generation": {}
        }
      }
    }
  ]
}
